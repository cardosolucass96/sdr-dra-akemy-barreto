{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipefacil.local/schemas/golden-dataset-case.schema.json",
  "title": "Pipefacil Golden Dataset Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "status",
    "source",
    "scenario",
    "cut",
    "input",
    "expected",
    "evaluation",
    "metadata"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{2,80}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": ["candidate", "approved", "deprecated"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["synthetic", "langfuse_trace", "manual_trace_export", "conversation_review"]
        },
        "trace_id": {
          "type": ["string", "null"]
        },
        "observation_id": {
          "type": ["string", "null"]
        },
        "reviewed_by": {
          "type": ["string", "null"]
        },
        "reviewed_at": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "tags"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3
        },
        "description": {
          "type": "string",
          "minLength": 3
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "turn_index", "reason"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["conversation_start", "mid_conversation", "after_tool", "handoff", "terminal"]
        },
        "turn_index": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messages_so_far"],
      "properties": {
        "messages_so_far": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "content"],
            "properties": {
              "role": {
                "type": "string",
                "enum": ["system", "user", "assistant", "tool"]
              },
              "content": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": ["string", "null"]
              }
            }
          }
        },
        "state_snapshot": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["next_behavior", "ideal_response", "success_criteria", "must_not"],
      "properties": {
        "next_behavior": {
          "type": "string",
          "minLength": 3
        },
        "ideal_response": {
          "type": "string",
          "minLength": 3
        },
        "success_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "must_not": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "minimum_score", "rubric"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["rubric", "exact", "manual_review"]
        },
        "minimum_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rubric": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "weight", "description"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "owner", "notes"],
      "properties": {
        "created_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
